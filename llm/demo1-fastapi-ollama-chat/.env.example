# Base URL of your Ollama server (default when running Ollama in Docker on your machine)
OLLAMA_BASE_URL=http://localhost:11434

# Model name to use, must already be pulled in Ollama (e.g. `ollama pull llama3`)
OLLAMA_MODEL=llama3

# Optional: only needed if your Ollama endpoint is behind a proxy/gateway that requires
# an API key (plain Ollama running in Docker does NOT need this).
OLLAMA_API_KEY=
